root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Shell style, enforced by shfmt in CI (Google Shell Style Guide layout)
[{doppeldock,*.sh}]
indent_style = space
indent_size = 2
switch_case_indent = true
