  $.NSGraphicsContext.setCurrentContext(ctx);
  var body = $.NSMakeRect(100 * k, 100 * k, 824 * k, 824 * k);
  ctx.saveGraphicsState;
  $.NSBezierPath.bezierPathWithRoundedRectXRadiusYRadius(body, 185 * k, 185 * k).addClip;
  var icon = $.NSWorkspace.sharedWorkspace.iconForFile(appPath);
  icon.size = $.NSMakeSize(px, px);
  icon.drawInRectFromRectOperationFraction($.NSMakeRect(0, 0, px, px), $.NSZeroRect, 2, 1);
  if (tint) { col.setFill; $.NSRectFillUsingOperation(body, 27); }
  ctx.restoreGraphicsState;
  if (withBadge) {
  var d = 330 * k, bx = 924 * k - d - 18 * k, by = 118 * k;
  col.setFill;
  $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(bx, by, d, d)).fill;
  var ring = $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(bx + 11 * k, by + 11 * k, d - 22 * k, d - 22 * k));
  ring.lineWidth = 22 * k;
  $.NSColor.whiteColor.setStroke;
  ring.stroke;
  var font = $.NSFont.systemFontOfSizeWeight(200 * k, 0.56);
  var attrs = $.NSMutableDictionary.alloc.init;
  attrs.setObjectForKey(font, $("NSFont"));
  attrs.setObjectForKey($.NSColor.whiteColor, $("NSColor"));
  var str = $(letter), ts = str.sizeWithAttributes(attrs);
  str.drawAtPointWithAttributes($.NSMakePoint(bx + d / 2 - ts.width / 2, by + d / 2 - font.capHeight / 2 + font.descender), attrs);
  }
  $.NSGraphicsContext.restoreGraphicsState;
  var img = $.NSImage.alloc.initWithSize($.NSMakeSize(px, px));
  img.addRepresentation(rep);
  return img;
}

// A colour dot for the Colour list, drawn at twice the size for Retina screens.
function swatch(hex) {
  var rep = $.NSBitmapImageRep.alloc.initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(
    null, 28, 28, 8, 4, true, false, "NSDeviceRGBColorSpace", 0, 0);
  rep.size = $.NSMakeSize(14, 14);
  $.NSGraphicsContext.saveGraphicsState;
  try {
    $.NSGraphicsContext.setCurrentContext($.NSGraphicsContext.graphicsContextWithBitmapImageRep(rep));
    rgb(hex).setFill;
    $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(1, 1, 12, 12)).fill;
  } finally {
    $.NSGraphicsContext.restoreGraphicsState;
  }
  var img = $.NSImage.alloc.initWithSize($.NSMakeSize(14, 14));
  img.addRepresentation(rep);
  return img;
}

