cmd_install() {
  local dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir)
        need_arg "$@"
        dir="$2"
        shift 2
        ;;
      *) die "unknown option for install: $1" ;;
    esac
  done
  [[ -n "$dir" ]] || dir=$(default_install_dir)
  mkdir -p "$dir" 2>/dev/null || true
  dir=$(canon_dir "$dir")
  [[ -n "$dir" && -w "$dir" ]] || die "cannot write to ${dir:-the install folder}"
  local target="$dir/DoppelDock.app"
  if [[ -e "$target" ]]; then
    [[ "$(plist_get "$target/Contents/Info.plist" CFBundleIdentifier)" == "$DOPPELDOCK_APP_ID" ]] ||
      die "$target exists and is not DoppelDock; not touching it"
    bundle_in_use "$target" && die "DoppelDock is open; quit it first"
  fi

  WORK=$(mktemp -d "$dir/.doppeldock.XXXXXX") || die "cannot create a work folder in $dir"
  local app="$WORK/DoppelDock.app" plist
  write_gui_script "$WORK/gui.js"
  osacompile -l JavaScript -s -o "$app" "$WORK/gui.js" 2>"$WORK/osacompile.log" ||
    die "building the DoppelDock app failed: $(cat "$WORK/osacompile.log")"
  plist="$app/Contents/Info.plist"
  cp "$SELF" "$app/Contents/Resources/doppeldock"
  chmod 755 "$app/Contents/Resources/doppeldock"
  plutil -replace CFBundleIdentifier -string "$DOPPELDOCK_APP_ID" "$plist"
  plutil -replace CFBundleName -string DoppelDock "$plist"
  plutil -replace CFBundleShortVersionString -string "$VERSION" "$plist"
  if make_doppeldock_icon "$app/Contents/Resources/applet.icns" "$WORK"; then
    $PB -c "Delete :CFBundleIconName" "$plist" 2>/dev/null || true
    plutil -replace CFBundleIconFile -string applet "$plist"
    rm -f "$app/Contents/Resources/Assets.car"
  fi
  codesign --force -s - -i "$DOPPELDOCK_APP_ID" "$app" 2>/dev/null || die "signing the DoppelDock app failed"
  codesign --verify --deep --strict "$app" 2>/dev/null || die "signature check failed"

  if [[ -e "$target" ]]; then
    SWAP_TARGET="$target"
    mv "$target" "$WORK/previous.app" || die "cannot move the old DoppelDock app out of the way"
  fi
  mv "$app" "$target" || die "cannot install $target"
  SWAP_TARGET=""
  "$LSREGISTER" -f "$target" >/dev/null 2>&1 || true
  cleanup
  WORK=""
  info "Installed: $target"
  info "Open DoppelDock from your Applications folder."
}

# ---------------------------------------------------------------------------
# Terminal menu
# ---------------------------------------------------------------------------

confirm() { # question -> 0 for yes
  local a
  read -r -p "$1 [y/N] " a || return 1
  [[ "$a" == y || "$a" == yes ]]
}

copy_mode_warning() {
  cat <<'TXT'

  To give it its own icon, DoppelDock makes a copy of the app and signs it on
  this Mac (instead of the app's maker).

  - The copy updates itself from the original the next time you open it after
    an update.
  - macOS may ask again for permissions such as camera or microphone, and
    whether the copy may use "<App> Safe Storage". Choose "Always Allow".
  - The copy is not signed by the app's maker, so it is less protected
    against other programs on this Mac changing it.
  - A few features of the app may not work in the copy.
  - The app's terms of use may not allow modifying it. Please check them.

TXT
}

pick_from_list() { # prompt items... ; prints the chosen item, returns 1 on q/empty
  local prompt="$1" i choice
  shift
  local items=("$@")
  for i in "${!items[@]}"; do
    printf '  %2d) %s\n' "$((i + 1))" "$(app_display_name "${items[$i]}")" >&2
  done
  read -r -p "$prompt" choice || return 1
  [[ -n "$choice" && "$choice" != q ]] || return 1
  if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#items[@]})); then
    printf '%s\n' "${items[$((choice - 1))]}"
  else
    printf '%s\n' "$choice"
  fi
}

# A path typed or dragged into Terminal: trim, unquote, unescape.
clean_path() {
  printf '%s' "$1" | sed -E "s/^[[:space:]]+//; s/[[:space:]]+\$//" | sed -E "s/^[\"']//; s/[\"']\$//" | sed -E 's/\\(.)/\1/g'
}

menu_new() {
  local sources=() a src label mode=launcher choice dir made
  while IFS= read -r a; do [[ -n "$a" ]] && sources+=("$a"); done < <(find_sources)
  echo
  echo "Which app would you like a second copy of?"
  if ((${#sources[@]})); then
    src=$(pick_from_list "Number (or drag an app here, q to go back): " "${sources[@]}") || return 0
  else
    read -r -p "Drag the app here: " src || return 0
  fi
  src=$(clean_path "$src")
  src="${src%/}"
  [[ -d "$src" ]] || {
    warn "not found: $src"
    return 0
  }
  is_electron "$src" || {
    warn "$(app_display_name "$src") is not an Electron app; DoppelDock only supports Electron apps"
    return 0
  }

  echo
  read -r -p "Name for this profile [Personal]: " label || return 0
  [[ -n "$label" ]] || label=Personal
  (validate_label "$label") || return 0
  label=$(capitalize "$label")

  echo
  echo "Should it show its own icon in the Dock while it is open?"
  echo "  1) Yes, DoppelDock makes a separate copy of the app"
  echo "  2) No, nothing is modified"
  read -r -p "Choose [1]: " choice || return 0
  if [[ "$choice" != 2 ]]; then
    copy_mode_warning
    confirm "Make the copy?" || {
      echo "Cancelled."
      return 0
    }
    mode=copy
  fi

  dir=$(default_install_dir)
  made="$dir/$(app_display_name "$src") $label.app"
  echo
  /bin/bash "$SELF" new --app "$src" --name "$label" --mode "$mode" --install-dir "$dir" --yes || return 0
  echo
  echo "Open it, sign in with your other account, and keep it in the Dock"
  echo "(right-click its icon while it is open: Options > Keep in Dock)."
  if confirm "Open it now?"; then open "$made"; fi
  return 0
}

menu_pick_profile() { # prompt -> path
  local profiles=() a
  while IFS= read -r a; do [[ -n "$a" ]] && profiles+=("$a"); done < <(find_profiles)
  ((${#profiles[@]})) || {
    echo "You have no profiles yet." >&2
    return 1
  }
  pick_from_list "$1" "${profiles[@]}"
}

menu_rebuild() {
  local app
  app=$(menu_pick_profile "Update which? (q to go back) ") || return 0
  /bin/bash "$SELF" rebuild "$app" || true
}

menu_remove() {
  local app
  app=$(menu_pick_profile "Remove which? (q to go back) ") || return 0
  is_doppeldock_app "$app" || {
    warn "not a DoppelDock app: $app"
    return 0
  }
  confirm "Remove $(app_display_name "$app")?" || return 0
  if confirm "Also move its sign-in and settings to the Trash?"; then
    /bin/bash "$SELF" remove "$app" --delete-data || true
  else
    /bin/bash "$SELF" remove "$app" || true
  fi
}

menu() {
  while true; do
    cat <<TXT

DoppelDock: use a second account in an app, side by side
   1) New profile
   2) My profiles
   3) Update a profile
   4) Remove a profile
   5) Install the DoppelDock app (no Terminal next time)
   q) Quit
TXT
    local choice
    read -r -p "Choose: " choice || exit 0
    case "$choice" in
      1) menu_new ;;
      2)
        echo
        cmd_list
        ;;
      3) menu_rebuild ;;
      4) menu_remove ;;
      5) /bin/bash "$SELF" install || true ;;
      q | "") exit 0 ;;
      *) echo "Unknown choice." ;;
    esac
  done
}

usage() { sed -n '2,18p' "$SELF" | sed 's/^# \{0,1\}//'; }

# ---------------------------------------------------------------------------

[[ "$(uname -s)" == Darwin ]] || die "DoppelDock runs on macOS only"

case "${1:-}" in
  "") menu ;;
  install)
    shift
    cmd_install "$@"
    ;;
  new)
    shift
    cmd_new "$@"
    ;;
  list) cmd_list ;;
  rebuild)
    shift
    cmd_rebuild "$@"
    ;;
  change)
    shift
    cmd_change "$@"
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  sources) find_sources ;;   # used by the DoppelDock app
  profiles) find_profiles ;; # used by the DoppelDock app
  help | -h | --help) usage ;;
  --version | version) echo "DoppelDock $VERSION" ;;
  *) die "unknown command '$1' (try: doppeldock help)" ;;
esac
