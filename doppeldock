DOPPELDOCK_APP_ID="io.github.zarinlab.doppeldock"

write_gui_script() { # file
  cat >"$1" <<'JS'
ObjC.import("Cocoa");
var app = Application.currentApplication();
app.includeStandardAdditions = true;
var TITLE = "DoppelDock";
var DD = $.NSBundle.mainBundle.bundlePath.js + "/Contents/Resources/doppeldock";
var LOG_DIR = $.NSHomeDirectory().js + "/Library/Logs/DoppelDock";
var COLORS = [["Green", "#2F9E44"], ["Blue", "#1971C2"], ["Purple", "#7048E8"], ["Pink", "#C2255C"],
              ["Orange", "#E8590C"], ["Teal", "#0C8599"], ["Red", "#E03131"], ["Gray", "#495057"]];
var STYLES = [["Colour and badge", "tint+badge"], ["Colour only", "tint"], ["Badge only (original colours)", "badge"]];
var APPEARANCES = [["Same as the Mac", "system"], ["Light", "light"], ["Dark", "dark"]];
// Text alignment numbers differ by processor (Apple silicon: centre 1, right 2; Intel: the
// reverse), and the scripting bridge only knows the Intel ones.
var ARM = app.doShellScript("/usr/bin/uname -m") === "arm64";
var ALIGN_CENTER = ARM ? 1 : 2, ALIGN_RIGHT = ARM ? 2 : 1;

// ---- helpers ---------------------------------------------------------------
function q(s) { return "'" + String(s).replace(/'/g, "'\\''") + "'"; }
function dd(args) { return app.doShellScript("/bin/bash " + [DD].concat(args).map(q).join(" "), {alteringLineEndings: false}); }
function lines(s) { return s.split("\n").filter(function (x) { return x.length > 0; }); }
function base(p) { return String(p).replace(/\/+$/, "").split("/").pop().replace(/\.app$/i, ""); }
function quoted(s) { return "“" + s + "”"; }
function cleanError(e) {
  var m = String((e && e.message) || e);
  var i = m.lastIndexOf("doppeldock: ");
  return i >= 0 ? m.slice(i + 12) : m;
}
function log(msg) {
  try {
    app.doShellScript("mkdir -p " + q(LOG_DIR) + " && printf '%s\\n' " + q(new Date().toISOString() + " " + msg) +
                      " >> " + q(LOG_DIR + "/app.log"));
  } catch (e) {}
}
function alert(title, text, buttons, style) { // -> index of the clicked button
  var a = $.NSAlert.alloc.init;
  a.messageText = title;
  a.informativeText = text || "";
  a.alertStyle = (style === undefined) ? 1 : style;  // 1 = informational
  (buttons || ["OK"]).forEach(function (b) { a.addButtonWithTitle(b); });
  return Number(a.runModal) - 1000;
}
// NSApp.activate replaces activateIgnoringOtherApps: from macOS 14; older systems keep the old call.
function macOSMajor() { return Number($.NSProcessInfo.processInfo.operatingSystemVersion.majorVersion); }
function activateApp() {
  if (macOSMajor() >= 14) $.NSApp.activate;
  else $.NSApp.activateIgnoringOtherApps(true);
}
var WEBSITE = "https://zarinlab.github.io/doppeldock/";
function showAbout() {
  var center = $.NSMutableParagraphStyle.alloc.init;
  center.alignment = ALIGN_CENTER;
  var text = "Use two accounts in the same app on your Mac, side by side.\nFree and open source (MIT licence).\n\n" +
             "Unofficial: not affiliated with the makers of the apps it works with. " +
             "App names are trademarks of their owners.\n\n";
  var link = WEBSITE.replace(/^https:\/\//, "").replace(/\/$/, "");
  // (JXA can't call NSAttributedString's initWithString:…, so build it in place.)
  var credits = $.NSMutableAttributedString.alloc.init;
  credits.replaceCharactersInRangeWithString($.NSMakeRange(0, 0), text + link);
  credits.addAttributesRange($({NSFont: $.NSFont.systemFontOfSize(11), NSParagraphStyle: center,
                                NSColor: $.NSColor.labelColor}), $.NSMakeRange(0, text.length + link.length));
  credits.addAttributeValueRange("NSLink", $.NSURL.URLWithString(WEBSITE), $.NSMakeRange(text.length, link.length));
  var info = $.NSBundle.mainBundle.infoDictionary;
  $.NSApp.orderFrontStandardAboutPanelWithOptions($({
    ApplicationName: TITLE,
    ApplicationVersion: ObjC.unwrap(info.objectForKey("CFBundleShortVersionString")) || "",
    Version: "",
    Copyright: "© 2026 The DoppelDock authors",
    Credits: credits
  }));
  activateApp();
}
// The app menu's "About DoppelDock" shows the panel above (with the website link).
function hookAboutMenu() {
  var main = $.NSApp.mainMenu;
  if (!main || main.isNil() || Number(main.numberOfItems) < 1) return;
  var sub = main.itemAtIndex(0).submenu;
  if (!sub || sub.isNil()) return;
  for (var i = 0; i < Number(sub.numberOfItems); i++) {
    var it = sub.itemAtIndex(i);
    if ((it.action && ObjC.unwrap(it.action) === "orderFrontStandardAboutPanel:") || /^About /.test(it.title.js)) {
      it.target = controller;
      it.action = "showAbout:";
      return;
    }
  }
  log("no About item in the app menu");
}
function fail(e) {
  if (e && e.errorNumber === -128) return;
  var m = cleanError(e);
  log(m);
  alert("DoppelDock could not finish", m, ["OK"], 2);
}
function rgb(hex) {
  var v = parseInt(hex.slice(1), 16);
  return $.NSColor.colorWithSRGBRedGreenBlueAlpha(((v >> 16) & 255) / 255, ((v >> 8) & 255) / 255, (v & 255) / 255, 1);
}
function letterOf(name) { return name ? name.charAt(0).toUpperCase() : "?"; }

// The same badged icon the profile will get (preview).
function badgeImage(appPath, hex, letter, style) {
  var px = 512, k = px / 1024, col = rgb(hex);
