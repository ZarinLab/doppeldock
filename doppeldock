function loadProfiles(selectPath) {
  rows = lines(dd(["profiles"])).map(function (path) {
    var d = $.NSDictionary.dictionaryWithContentsOfFile(path + "/Contents/Info.plist");
    function g(k) { if (d.isNil()) return ""; var v = d.objectForKey(k); return v.isNil() ? "" : v.js; }
    return {path: path, name: base(path), label: g("DoppelDockLabel"), mode: g("DoppelDockMode"),
            sourcePath: g("DoppelDockSourceApp"), source: base(g("DoppelDockSourceApp")),
            color: g("DoppelDockColor"), style: g("DoppelDockStyle") || "tint+badge",
            appearance: g("DoppelDockAppearance") || "system",
            icon: $.NSWorkspace.sharedWorkspace.iconForFile(path)};
  }).sort(function (a, b) { return a.name.localeCompare(b.name); });
  ui.table.reloadData;
  ui.table.deselectAll($());
  ui.empty.hidden = rows.length > 0;
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].path === selectPath) ui.table.selectRowIndexesByExtendingSelection($.NSIndexSet.indexSetWithIndex(i), false);
  }
  updateButtons();
}

function selected() { var i = Number(ui.table.selectedRow); return (i >= 0 && i < rows.length) ? rows[i] : null; }

function updateButtons() {
  var has = selected() !== null;
  ui.open.enabled = has; ui.edit.enabled = has; ui.remove.enabled = has; ui.add.enabled = true;
}

function setBusy(text) {
  if (text) {
    ui.subtitle.stringValue = text;
    ui.spinner.hidden = false;
    ui.spinner.startAnimation($());
    ui.open.enabled = false; ui.edit.enabled = false; ui.remove.enabled = false; ui.add.enabled = false;
  } else {
    ui.subtitle.stringValue = ui.subtitleText;
    ui.spinner.stopAnimation($());
    ui.spinner.hidden = true;
    updateButtons();
  }
  ui.win.displayIfNeeded;
}

function guarded(fn) {
  try { fn(); } catch (e) {
    setBusy(null);
    fail(e);
    try { loadProfiles(); } catch (e2) { log(e2); }
  }
}

