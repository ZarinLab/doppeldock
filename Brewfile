# Development tools for DoppelDock. DoppelDock itself needs only macOS.
# Install them with: brew bundle
brew "shellcheck"   # lint (CI: Lint)
brew "shfmt"        # code style (CI pins v3.14.1 via shfmt-py 4.2.0)
brew "bash"         # a newer bash, only for measuring test coverage
brew "ruby"         # runs bashcov (see Gemfile) for test coverage
brew "node"         # downloads Electron's sample app for the tests
